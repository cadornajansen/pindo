<Window x:Class="Pointly.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pindo — Development diagnostics" Height="350" Width="720">
    <DockPanel Margin="12">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="0,0,0,4"
                   TextWrapping="Wrap" Text="Starting..." />
        <TextBlock x:Name="HotkeyHint" DockPanel.Dock="Top" Margin="0,0,0,8" Opacity="0.7"
                   Text="Ctrl+Space: UIA tutor with visual fallback. Press again while waiting to cancel." />
        <ListBox x:Name="LogList" />
    </DockPanel>
</Window>
