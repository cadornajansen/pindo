<Window x:Class="Pointly.App.Presentation.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Pointly.App.Presentation"
        Title="Pindo" Width="428" SizeToContent="Height" MaxHeight="340"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="#F3F3F3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#505050"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#505050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12,26,12,12">
    <Border x:Name="Card" Background="#383838"
            BorderBrush="#999999" BorderThickness="1" CornerRadius="16" Padding="20,13,12,8">
        <Border.RenderTransform><TranslateTransform x:Name="EntranceMotion"/></Border.RenderTransform>
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.3"/></Border.Effect>
        <StackPanel>
            <TextBlock x:Name="Instruction" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#F0F0F0"
                       FontSize="14" Margin="0,0,5,12" MaxHeight="130"/>
            <Button x:Name="CheckButton" Visibility="Collapsed" Content="Check again" HorizontalAlignment="Left"
                    Padding="8,3" Margin="0,0,0,8" Click="OnCheck"/>
            <Grid MinHeight="26">
                <TextBlock x:Name="Placeholder" Text="How can I help you today?" FontSize="15"
                           Foreground="#909090" IsHitTestVisible="False" Margin="0,2,0,0"/>
                <TextBox x:Name="Question" AutomationProperties.Name="Ask Pindo"
                         FontSize="15" Foreground="#F2F2F2" CaretBrush="White"
                         Background="Transparent" BorderThickness="0" Padding="0,2,0,0"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="96" MaxLength="2000"
                         VerticalScrollBarVisibility="Auto" TextChanged="OnQuestionChanged"/>
            </Grid>
            <TextBlock x:Name="Selection" Visibility="Collapsed" FontSize="11" Foreground="#B8B8B8"
                       TextWrapping="Wrap" MaxHeight="44" Margin="0,5,0,0"/>
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="State" FontSize="11" Foreground="#B8B8B8" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SelectButton" Style="{StaticResource IconButton}" Click="OnSelect" ToolTip="Select files or workspace"
                            AutomationProperties.Name="Select files or workspace">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="15"/>
                    </Button>
                    <Button x:Name="ClearButton" Style="{StaticResource IconButton}" Click="OnClear" ToolTip="Clear question"
                            AutomationProperties.Name="Clear question">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="14"/>
                    </Button>
                    <Button x:Name="CancelButton" Visibility="Collapsed" Style="{StaticResource IconButton}"
                            Click="OnCancel" ToolTip="Cancel" AutomationProperties.Name="Cancel">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="15"/>
                    </Button>
                    <Button x:Name="MicrophoneButton" Style="{StaticResource IconButton}" Click="OnMicrophone"
                            ToolTip="Turn microphone on" AutomationProperties.Name="Turn microphone on">
                        <TextBlock x:Name="MicrophoneIcon" FontFamily="Segoe Fluent Icons" Text="&#xEC54;" FontSize="15"/>
                    </Button>
                    <Button x:Name="Send" Visibility="Collapsed" Style="{StaticResource IconButton}"
                            Click="OnSend" ToolTip="Send question (Enter)" AutomationProperties.Name="Send question">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72A;" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
    <local:BusyBorder x:Name="ThinkingBorder"/>
    </Grid>
</Window>
