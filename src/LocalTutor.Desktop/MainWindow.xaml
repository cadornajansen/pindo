<Window x:Class="LocalTutor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LocalTutor" Width="520" Height="540" MinWidth="460" MinHeight="510"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Topmost="True" Background="#17212E" Foreground="#F0F4F8" FontFamily="Segoe UI"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2E4056" />
            <Setter Property="Foreground" Value="#F0F4F8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="#F6C566" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#3A4C62" BorderThickness="1" CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="LocalTutor" FontSize="24" FontFamily="Segoe UI Semibold" />
                    <TextBlock Text="A little help, right where you work." Foreground="#B4C3D4" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="HideButton" Content="Hide" Click="Hide_Click" Margin="0,0,6,0"
                            AutomationProperties.Name="Hide assistant" ToolTip="Hide (Esc); reopen with Ctrl + Space" />
                    <Button Content="&#x2715;" Click="Close_Click" AutomationProperties.Name="Exit LocalTutor" ToolTip="Exit LocalTutor" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="MOCK MODE" FontFamily="Consolas" FontWeight="Bold" Foreground="#F6C566" />
                <TextBlock Text="Try the interface. AI tutoring comes next." Foreground="#B4C3D4" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2">
                <Label Content="What would you like to learn?" Target="{Binding ElementName=InstructionInput}"
                       Foreground="#F0F4F8" Padding="0,0,0,8" FontWeight="SemiBold" />
                <TextBox x:Name="InstructionInput" Background="#223044" Foreground="#F0F4F8"
                         BorderBrush="#7187A1" CaretBrush="#F6C566" Padding="12" FontSize="15"
                         AutomationProperties.Name="Your instruction" MaxLength="2000"
                         VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Auto" />
                <TextBlock Text="Try: Paano maglagay ng picture sa PowerPoint?" Foreground="#B4C3D4"
                           FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="SubmitButton" Grid.Row="3" Content="Ask tutor  &#x21B5;" IsDefault="True"
                    Click="Submit_Click" Background="#F6C566" Foreground="#17212E" FontWeight="SemiBold"
                    HorizontalAlignment="Right" Margin="0,14,0,18" AutomationProperties.Name="Ask tutor" />
            <Border Grid.Row="4" Background="#223044" CornerRadius="8" Padding="16" MinHeight="105">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="NEXT STEP" FontFamily="Consolas" Foreground="#B4C3D4" FontSize="12" Margin="0,0,0,8" />
                        <TextBlock x:Name="ResponseText" Text="Type a question above to try the mock tutor."
                                   TextWrapping="Wrap" FontSize="14" LineHeight="21"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="5" Margin="0,16,0,0">
                <TextBlock x:Name="HotkeyStatus" Foreground="#B4C3D4" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="OllamaStatus" Text="Checking local Ollama…" Foreground="#B4C3D4"
                           FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
