{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    { "$ref": "#/$defs/pdf.inspect" },
    { "$ref": "#/$defs/pdf.merge" },
    { "$ref": "#/$defs/pdf.split" },
    { "$ref": "#/$defs/pdf.extract_text" },
    { "$ref": "#/$defs/pdf.render_pages" }
  ],
  "$defs": {
  "pdf.inspect": {
    "type": "object",
    "additionalProperties": false,
    "required": ["InputPath"],
    "properties": { "InputPath": { "$ref": "#/$defs/pdfPath" } }
  },
  "pdf.merge": {
    "type": "object",
    "additionalProperties": false,
    "required": ["InputPaths", "OutputPath"],
    "properties": {
      "InputPaths": { "type": "array", "minItems": 2, "maxItems": 10, "uniqueItems": true, "items": { "$ref": "#/$defs/pdfPath" } },
      "OutputPath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\.[pP][dD][fF]$" }
    }
  },
  "pdf.split": {
    "type": "object",
    "additionalProperties": false,
    "required": ["InputPath", "OutputDirectory", "FileNamePrefix"],
    "properties": {
      "InputPath": { "$ref": "#/$defs/pdfPath" },
      "OutputDirectory": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "FileNamePrefix": { "$ref": "#/$defs/fileNamePrefix" },
      "StartPage": { "type": "integer", "minimum": 1 },
      "EndPage": { "type": "integer", "minimum": 1 },
      "OnePagePerFile": { "type": "boolean", "default": false }
    },
    "oneOf": [
      { "required": ["StartPage", "EndPage"], "properties": { "OnePagePerFile": { "const": false } } },
      { "required": ["OnePagePerFile"], "properties": { "OnePagePerFile": { "const": true }, "StartPage": false, "EndPage": false } }
    ]
  },
  "pdf.extract_text": {
    "type": "object",
    "additionalProperties": false,
    "required": ["InputPath", "Pages", "OutputPath"],
    "properties": {
      "InputPath": { "$ref": "#/$defs/pdfPath" },
      "Pages": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
      "OutputPath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\.[tT][xX][tT]$" }
    }
  },
  "pdf.render_pages": {
    "type": "object",
    "additionalProperties": false,
    "required": ["InputPath", "Pages", "OutputDirectory", "FileNamePrefix", "Format"],
    "properties": {
      "InputPath": { "$ref": "#/$defs/pdfPath" },
      "Pages": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
      "OutputDirectory": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "FileNamePrefix": { "$ref": "#/$defs/fileNamePrefix" },
      "Format": { "enum": ["Png", "Jpeg"] },
      "Dpi": { "type": "integer", "minimum": 72, "maximum": 300, "default": 150 }
    }
  },
    "pdfPath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\.[pP][dD][fF]$" },
    "fileNamePrefix": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?!\\s*$)(?!.*[. ]$)[^/\\\\:*?\"<>|\\x00-\\x1F\\x7F]+$" }
  }
}
